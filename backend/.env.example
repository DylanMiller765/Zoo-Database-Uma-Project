# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# Switch between TEST mode and PRODUCTION mode by changing MAIL_SERVICE
#
# TEST MODE (Safe for development - sends to fake inbox):
#   - Set MAIL_SERVICE="ethereal"
#   - No other email config needed
#   - View emails at: https://ethereal.email/ (check server console for URLs)
#   - Does NOT send real emails
#   - Does NOT count toward your 300/day limit
#
# PRODUCTION MODE (Sends real emails via Brevo):
#   - Set MAIL_SERVICE="brevo" (or any value other than "ethereal")
#   - Fill in all BREVO_* variables below
#   - Get credentials from: https://app.brevo.com/settings/keys/smtp
#   - Free tier: 300 emails/day
#   - Requires verified sender email in Brevo dashboard
# ============================================================

# Current mode: "ethereal" for test, "brevo" for production
MAIL_SERVICE="ethereal"

# ============================================================
# PRODUCTION MODE SETTINGS (only needed when MAIL_SERVICE != "ethereal")
# ============================================================
# Brevo SMTP Configuration
BREVO_HOST="smtp-relay.brevo.com"
BREVO_PORT=587
BREVO_USER="your-brevo-login-email@example.com"
BREVO_KEY="your-brevo-smtp-api-key-here"

# Verified Sender Email (REQUIRED - must be verified in Brevo dashboard)
VERIFIED_SENDER_EMAIL="your-verified-email@example.com"